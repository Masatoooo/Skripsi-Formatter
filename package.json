{
  "name": "skripsi-formatter-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Skripsi Formatter web app and backend API",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint"
  }
}
