{
  "profile_id": "contoh-s1-skripsi",
  "name": "CONTOH: Skripsi S1 (Template Pedoman Umum)",
  "version": "0.1.0",
  "language": "id",
  "source": {
    "document": "Pedoman Penulisan Skripsi (CONTOH)",
    "edition": "2024",
    "pages": "Halaman 1-50",
    "notes": "Nilai di file ini adalah contoh format umum skripsi di Indonesia."
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins_cm": {
      "top": 4.0,
      "left": 4.0,
      "bottom": 3.0,
      "right": 3.0
    },
    "header_footer_distance_cm": {
      "header": 1.25,
      "footer": 1.25
    }
  },
  "text": {
    "font_family": "Times New Roman",
    "font_size_pt": 12,
    "color_hex": "000000"
  },
  "roles": {
    "body": {
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "alignment": "justify",
      "first_line_indent_cm": 1.25
    },
    "chapter_label": {
      "text_pattern": "^BAB\\s+[IVXLC]+$",
      "bold": true,
      "all_caps": true,
      "alignment": "center",
      "font_size_pt": 12,
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "keep_with_next": true,
      "page_break_before": true
    },
    "chapter_title": {
      "bold": true,
      "all_caps": true,
      "alignment": "center",
      "font_size_pt": 12,
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 12,
      "keep_with_next": true
    },
    "heading_2": {
      "bold": true,
      "alignment": "left",
      "font_size_pt": 12,
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "space_after_pt": 6,
      "left_indent_cm": 0,
      "hanging_indent_cm": 1.0,
      "numbering": "decimal_dotted",
      "keep_with_next": true
    },
    "heading_3": {
      "bold": true,
      "alignment": "left",
      "font_size_pt": 12,
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "left_indent_cm": 0,
      "hanging_indent_cm": 1.25,
      "numbering": "decimal_dotted",
      "keep_with_next": true
    },
    "caption_figure": {
      "alignment": "center",
      "font_size_pt": 11,
      "line_spacing": 1.0,
      "space_before_pt": 6,
      "space_after_pt": 12
    },
    "caption_table": {
      "alignment": "center",
      "font_size_pt": 11,
      "line_spacing": 1.0,
      "space_before_pt": 12,
      "space_after_pt": 6,
      "keep_with_next": true
    },
    "block_quote": {
      "line_spacing": 1.0,
      "left_indent_cm": 1.25,
      "right_indent_cm": 1.25,
      "first_line_indent_cm": 0,
      "alignment": "justify",
      "space_after_pt": 12
    },
    "table_text": {
      "font_size_pt": 11,
      "line_spacing": 1.0,
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "bibliography_entry": {
      "line_spacing": 1.0,
      "space_after_pt": 12,
      "alignment": "left",
      "hanging_indent_cm": 1.25,
      "sorted": "alphabetical"
    }
  },
  "page_numbering": {
    "cover": {
      "numbered": false
    },
    "front_matter": {
      "format": "lowerRoman",
      "start": 1,
      "position": "bottom_center"
    },
    "body": {
      "format": "decimal",
      "start": 1,
      "position": "top_right",
      "chapter_first_page": {
        "position": "bottom_center"
      }
    }
  },
  "structure": {
    "sections": [
      { "id": "cover", "match": "^HALAMAN SAMPUL$", "group": "cover", "required": true, "new_page": true },
      { "id": "approval", "match": "^LEMBAR PENGESAHAN$", "group": "front_matter", "required": true, "new_page": true },
      { "id": "preface", "match": "^KATA PENGANTAR$", "group": "front_matter", "required": true, "new_page": true },
      { "id": "abstract", "match": "^ABSTRAK$", "group": "front_matter", "required": true, "new_page": true },
      { "id": "toc", "match": "^DAFTAR ISI$", "group": "front_matter", "required": true, "new_page": true },
      { "id": "list_tables", "match": "^DAFTAR TABEL$", "group": "front_matter", "required": false, "new_page": true },
      { "id": "list_figures", "match": "^DAFTAR GAMBAR$", "group": "front_matter", "required": false, "new_page": true },
      { "id": "chapter_1", "match": "^BAB\\s+I$", "group": "body", "required": true, "new_page": true },
      { "id": "chapter_2", "match": "^BAB\\s+II$", "group": "body", "required": true, "new_page": true },
      { "id": "chapter_3", "match": "^BAB\\s+III$", "group": "body", "required": true, "new_page": true },
      { "id": "chapter_4", "match": "^BAB\\s+IV$", "group": "body", "required": true, "new_page": true },
      { "id": "chapter_5", "match": "^BAB\\s+V$", "group": "body", "required": true, "new_page": true },
      { "id": "references", "match": "^DAFTAR PUSTAKA$", "group": "body", "required": true, "new_page": true },
      { "id": "appendix", "match": "^LAMPIRAN", "group": "body", "required": false, "new_page": true }
    ],
    "enforce_order": true
  },
  "toc": {
    "title": "DAFTAR ISI",
    "levels": 3,
    "leader": "dots",
    "right_align_page_numbers": true,
    "list_of_figures": {
      "enabled": true,
      "title": "DAFTAR GAMBAR"
    },
    "list_of_tables": {
      "enabled": true,
      "title": "DAFTAR TABEL"
    }
  },
  "captions": {
    "figure": {
      "label": "Gambar",
      "position": "below",
      "numbering": "per_chapter",
      "separator": "."
    },
    "table": {
      "label": "Tabel",
      "position": "above",
      "numbering": "per_chapter",
      "separator": "."
    }
  },
  "tolerances": {
    "margin_cm": 0.05,
    "indent_cm": 0.05,
    "font_size_pt": 0,
    "spacing_pt": 0.5,
    "line_spacing": 0.02
  },
  "rules": [
    { "id": "HEAD-003", "fix_mode": "suggest", "severity": "warning" },
    { "id": "BIB-001", "fix_mode": "suggest", "severity": "warning" },
    { "id": "PARA-005", "enabled": true, "fix_mode": "suggest" }
  ]
}
